# Copy to backend/.env — every value is optional.

# SQLite file (defaults to backend/fireflies.db)
# DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated origins allowed by CORS, plus an optional regex (e.g. Vercel previews)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Seed the sample meetings when the database is empty
SEED_ON_STARTUP=true

# Optional LLM for summaries + AskFred (falls back to the built-in engine on any error).
# Leave both keys empty to use the built-in summarizer.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# auto = Claude if its key is set, else Gemini | claude | gemini | heuristic
AI_PROVIDER=auto
